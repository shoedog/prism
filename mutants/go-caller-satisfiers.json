{
  "lane": "Go caller-scoped satisfier memo",
  "lib_test_prefixes": [
    "resolution::go::satisfiers::"
  ],
  "mutations": {
    "GCS-caller-file": [
      "src/resolution/go/satisfiers.rs",
      "caller_file.to_string(),",
      "String::new(),",
      "resolution::go::satisfiers::tests::caller_file_and_promoted_and_method_and_owner_are_discriminators"
    ],
    "GCS-promoted-key": [
      "src/resolution/go/satisfiers.rs",
      "            include_promoted,\n        );",
      "            false,\n        );",
      "resolution::go::satisfiers::tests::caller_file_and_promoted_and_method_and_owner_are_discriminators"
    ],
    "GCS-method-key": [
      "src/resolution/go/satisfiers.rs",
      "method.to_string(),",
      "String::new(),",
      "resolution::go::satisfiers::tests::caller_file_and_promoted_and_method_and_owner_are_discriminators"
    ],
    "GCS-owner-key": [
      "src/resolution/go/satisfiers.rs",
      "owner.clone(),",
      "GoOwnerIdentity { package_dir: String::new(), package_clause: String::new(), name: String::new() },",
      "resolution::go::satisfiers::tests::caller_file_and_promoted_and_method_and_owner_are_discriminators"
    ],
    "GCS-reuse": [
      "src/resolution/go/satisfiers.rs",
      ".entry(key)\n            .or_default()",
      ".entry(key)\n            .and_modify(|entry| *entry = Arc::default())\n            .or_default()",
      "resolution::go::satisfiers::tests::concurrent_hits_share_initialization_and_graph_lifetimes_do_not_leak"
    ],
    "GCS-evidence-replay": [
      "src/resolution/go/satisfiers.rs",
      "result.clone()",
      "{ let mut result = result.clone(); result.selection.evidence = Default::default(); result }",
      "resolution::go::satisfiers::tests::full_values_match_reference_and_repeated_queries_compute_once"
    ],
    "GCS-telemetry-replay": [
      "src/resolution/go/satisfiers.rs",
      "result.clone()",
      "{ let mut result = result.clone(); result.promoted = Default::default(); result }",
      "resolution::go::satisfiers::tests::full_values_match_reference_and_repeated_queries_compute_once"
    ],
    "GCS-promoted-signature": [
      "src/resolution/go/satisfiers/compute.rs",
      "promoted_telemetry.signature_drop += 1;",
      "promoted_telemetry.signature_drop += 0;",
      "resolution::go::satisfiers::tests::full_values_match_reference_and_repeated_queries_compute_once"
    ],
    "GCS-step5-reuse": [
      "src/cpg/build.rs",
      "Self::step5_edges_for_caller(caller_id, sites, go_satisfiers, func_index)",
      "Self::step5_edges_for_caller(caller_id, sites, cg, func_index)",
      "resolution::go::satisfiers::tests::resolved_edges_telemetry_and_call_stats_json_match_reference"
    ],
    "GCS-step5b-reuse": [
      "src/cpg/build.rs",
      "                    go_satisfiers,",
      "                    cg,",
      "resolution::go::satisfiers::tests::resolved_edges_telemetry_and_call_stats_json_match_reference"
    ],
    "GCS-step5c-reuse": [
      "src/cpg/step5c_facts.rs",
      "let outcome = resolver.resolve_call_site_full(site);",
      "let outcome = resolver.graph().resolve_call_site_full(site);",
      "resolution::go::satisfiers::tests::resolved_edges_telemetry_and_call_stats_json_match_reference"
    ],
    "GCS-observer-scope": [
      "src/resolution/go/satisfiers.rs",
      "if observation\n                    .files\n                    .iter()\n                    .eq(self.graph.go_file_profiles.keys())\n                {",
      "if true {",
      "resolution::go::satisfiers::tests::phase_observation_excludes_unrelated_graphs"
    ]
  }
}
