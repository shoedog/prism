{
  "lane": "Opt-in build profiling",
  "source": "docs/BUILD-PROFILE.md",
  "mutations": {
    "PROFILE-disable-output": [
      "src/main.rs",
      "let _profile = prism::profile::Session::start();",
      "let _profile = ();",
      "build_profile_test::nav_profile_accounts_for_owners_and_searches"
    ],
    "PROFILE-drop-simple-counter": [
      "src/profile/owner.rs",
      "c.simple_searches += 1;",
      "c.simple_searches += 0;",
      "build_profile_test::nav_profile_accounts_for_owners_and_searches"
    ],
    "PROFILE-drop-member-counter": [
      "src/profile/owner.rs",
      "c.member_searches += 1;",
      "c.member_searches += 0;",
      "build_profile_test::summary_conserves_normal_population_and_member_searches"
    ],
    "PROFILE-drop-searched-bytes": [
      "src/profile/owner.rs",
      "c.searched_bytes += bytes as u64;",
      "c.searched_bytes += 0 * bytes as u64;",
      "build_profile_test::nav_profile_accounts_for_owners_and_searches"
    ],
    "PROFILE-summary-count": [
      "src/profile/summary.rs",
      "\"owner_count\":owners.len()",
      "\"owner_count\":0",
      "build_profile_test::nav_profile_accounts_for_owners_and_searches"
    ],
    "PROFILE-summary-drop-normal-population": [
      "src/profile/summary.rs",
      "let mut other: Vec<_> = ranked[split..].iter().map(|o| o.total_ns).collect();",
      "let mut other: Vec<_> = ranked[split..].iter().map(|o| o.total_ns).take(0).collect();",
      "build_profile_test::summary_conserves_normal_population_and_member_searches"
    ],
    "PROFILE-omit-step7": [
      "src/cpg/build.rs",
      "profile.next(\"cpg.step7\");",
      "profile.next(\"cpg.missing\");",
      "build_profile_test::review_profile_has_build_phases"
    ],
    "PROFILE-zero-rd": [
      "src/profile/owner.rs",
      "self.row.reaching_definitions_ns = self.rd.map(ns).unwrap_or(0);",
      "self.row.reaching_definitions_ns = 0;",
      "build_profile_test::nav_profile_accounts_for_owners_and_searches"
    ],
    "PROFILE-subset-root-omitted": [
      "src/call_graph.rs",
      "Stages::new(\"call_graph\", \"call_graph.direct_subset.prelude\")",
      "Stages::new(\"call_graph-missing\", \"call_graph.direct_subset.prelude\")",
      "build_profile_test::alternate_call_graph_paths_are_profiled"
    ],
    "PROFILE-skeleton-calls-omitted": [
      "src/call_graph.rs",
      "p.next(\"call_graph.skeleton.calls\");",
      "p.next(\"call_graph.skeleton.missing\");",
      "build_profile_test::alternate_call_graph_paths_are_profiled"
    ],
    "PROFILE-incremental-refresh-omitted": [
      "src/cpg/build.rs",
      "p.next(\"call_graph.incremental_refresh\");",
      "p.next(\"call_graph.incremental_missing\");",
      "build_profile_test::alternate_call_graph_paths_are_profiled"
    ],
    "PROFILE-json-write-error-swallowed": [
      "src/profile/mod.rs",
      "serde_json::to_writer(&mut *writer, value)?;",
      "let _ = serde_json::to_writer(&mut *writer, value);",
      "profile::tests::record_write_errors_cover_json_and_newline"
    ],
    "PROFILE-newline-write-error-swallowed": [
      "src/profile/mod.rs",
      "writer.write_all(b\"\\n\")",
      "{ let _ = writer.write_all(b\"\\n\"); Ok(()) }",
      "profile::tests::record_write_errors_cover_json_and_newline"
    ]
  },
  "lib_test_prefixes": [
    "profile::"
  ]
}
