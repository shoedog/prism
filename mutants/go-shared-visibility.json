{
  "lane": "Assembly shared Go visibility",
  "lib_test_prefixes": [
    "go_owner_partition::visibility::"
  ],
  "mutations": {
    "VIS-caller-profile": [
      "src/go_owner_partition/visibility.rs",
      "let key = (caller.profile_id, defining.profile_id, owns_test_namespace);",
      "let key = (0, defining.profile_id, owns_test_namespace);",
      "go_owner_partition::visibility::tests::keys_retain_both_profiles_and_test_namespace_and_share_equal_profiles"
    ],
    "VIS-defining-profile": [
      "src/go_owner_partition/visibility.rs",
      "let key = (caller.profile_id, defining.profile_id, owns_test_namespace);",
      "let key = (caller.profile_id, 0, owns_test_namespace);",
      "go_owner_partition::visibility::tests::keys_retain_both_profiles_and_test_namespace_and_share_equal_profiles"
    ],
    "VIS-test-namespace-key": [
      "src/go_owner_partition/visibility.rs",
      "let key = (caller.profile_id, defining.profile_id, owns_test_namespace);",
      "let key = (caller.profile_id, defining.profile_id, false);",
      "go_owner_partition::visibility::tests::keys_retain_both_profiles_and_test_namespace_and_share_equal_profiles"
    ],
    "VIS-test-directory": [
      "src/go_owner_partition/visibility.rs",
      "caller.dir == defining.dir",
      "true",
      "go_owner_partition::visibility::tests::keys_retain_both_profiles_and_test_namespace_and_share_equal_profiles"
    ],
    "VIS-test-package": [
      "src/go_owner_partition/visibility.rs",
      "caller.profile.package_clause == defining.profile.package_clause",
      "true",
      "go_owner_partition::visibility::tests::keys_retain_both_profiles_and_test_namespace_and_share_equal_profiles"
    ],
    "VIS-missing-profile": [
      "src/go_owner_partition/visibility.rs",
      "return (true, false);",
      "return (true, true);",
      "go_owner_partition::visibility::tests::every_pair_matches_frozen_helpers_including_missing_and_fallback"
    ],
    "VIS-test-declaration": [
      "src/go_owner_partition/visibility.rs",
      "if defining.is_test_file && !owns_test_namespace {",
      "if false {",
      "go_owner_partition::visibility::tests::keys_retain_both_profiles_and_test_namespace_and_share_equal_profiles"
    ],
    "VIS-caller-exactness": [
      "src/go_owner_partition/visibility.rs",
      "&& go_build_profile::profile_allows_exact(Some(caller))",
      "&& true",
      "go_owner_partition::visibility::tests::every_pair_matches_frozen_helpers_including_missing_and_fallback"
    ],
    "VIS-cap-fallback": [
      "src/go_owner_partition/visibility.rs",
      "None => compute(),",
      "None => (true, true),",
      "go_owner_partition::visibility::tests::every_pair_matches_frozen_helpers_including_missing_and_fallback"
    ],
    "VIS-cap-bound": [
      "src/go_owner_partition/visibility.rs",
      "shard.len() < self.memo.capacity",
      "true",
      "go_owner_partition::visibility::tests::concurrent_pairs_initialize_once_and_saturation_preserves_existing_hits"
    ],
    "VIS-hit-reuse": [
      "src/go_owner_partition/visibility.rs",
      "Some(entry) => *entry.get_or_init(compute),",
      "Some(_entry) => compute(),",
      "go_owner_partition::visibility::tests::concurrent_pairs_initialize_once_and_saturation_preserves_existing_hits"
    ],
    "VIS-package-override": [
      "src/go_build_profile.rs",
      "&& caller_package != candidate.package_clause",
      "&& caller.package_clause != candidate.package_clause",
      "go_owner_partition::visibility::tests::every_pair_matches_frozen_helpers_including_missing_and_fallback"
    ]
  }
}
