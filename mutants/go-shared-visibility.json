{
  "lane": "Clone-free Go visibility",
  "lib_test_prefixes": [
    "resolution::go::owner_partition::visibility::"
  ],
  "mutations": {
    "VIS-test-directory": [
      "src/resolution/go/owner_partition/visibility.rs",
      "crate::resolution::dir_of(caller_file)\n        == crate::resolution::dir_of(defining_file)",
      "true",
      "resolution::go::owner_partition::visibility::tests::profiles_and_test_namespace_preserve_visibility_and_exactness"
    ],
    "VIS-test-package": [
      "src/resolution/go/owner_partition/visibility.rs",
      "caller.package_clause == defining.package_clause",
      "true",
      "resolution::go::owner_partition::visibility::tests::profiles_and_test_namespace_preserve_visibility_and_exactness"
    ],
    "VIS-missing-profile": [
      "src/resolution/go/owner_partition/visibility.rs",
      "return (true, false);",
      "return (true, true);",
      "resolution::go::owner_partition::visibility::tests::every_pair_matches_frozen_clone_and_override_helpers"
    ],
    "VIS-test-declaration": [
      "src/resolution/go/owner_partition/visibility.rs",
      "if defining.is_test_file && !owns_test_namespace {",
      "if false {",
      "resolution::go::owner_partition::visibility::tests::profiles_and_test_namespace_preserve_visibility_and_exactness"
    ],
    "VIS-caller-exactness": [
      "src/resolution/go/owner_partition/visibility.rs",
      "&& go_build_profile::profile_allows_exact(Some(caller))",
      "&& true",
      "resolution::go::owner_partition::visibility::tests::every_pair_matches_frozen_clone_and_override_helpers"
    ],
    "VIS-package-override": [
      "src/resolution/go/build_profile.rs",
      "&& caller_package != candidate.package_clause",
      "&& caller.package_clause != candidate.package_clause",
      "resolution::go::owner_partition::visibility::tests::every_pair_matches_frozen_clone_and_override_helpers"
    ]
  }
}
