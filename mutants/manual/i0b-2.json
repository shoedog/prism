{
  "manual_only": true,
  "features": [
    "mcp"
  ],
  "mutants": [
    {
      "id": "I0b-default-on",
      "selector": "daemon_idle_tests::daemon_idle_wire_policy_default",
      "target": "prism-mcp",
      "description": "Enable the absent daemon flag; READY must still report zero/off.",
      "edits": [
        {
          "file": "src/bin/prism-mcp.rs",
          "old": "prism::mcp::idle::IdlePolicy::resolve(c.index_idle_secs.as_deref(), None, &config, false)?",
          "new": "prism::mcp::idle::IdlePolicy::resolve(c.index_idle_secs.as_deref().or(Some(\"600\")), None, &config, false)?"
        }
      ]
    },
    {
      "id": "I0b-wire-lies",
      "selector": "mcp::daemon::idle_wire_logging_tests::daemon_idle_logging_and_relief",
      "description": "Collapse unloaded into initial idle on the wire; the post-detach state assertion must fail.",
      "edits": [
        {
          "file": "src/mcp/daemon/control.rs",
          "old": "            Self::Unloaded { .. } => BuildState::Unloaded,",
          "new": "            Self::Unloaded { .. } => BuildState::Idle,"
        }
      ]
    },
    {
      "id": "I0b-drop-daemon-option",
      "selector": "daemon_idle_tests::daemon_idle_wire_policy_nonzero",
      "target": "prism-mcp",
      "description": "Drop the parsed nonzero idle policy on the real daemon construction path; effective READY must report one second.",
      "edits": [
        {
          "file": "src/mcp/daemon/run.rs",
          "old": "    parts.idle_timeout = options.idle_policy.timeout;",
          "new": "    parts.idle_timeout = None;"
        }
      ]
    },
    {
      "id": "I0b-relief-before-drop",
      "selector": "mcp::daemon::idle_wire_logging_tests::daemon_idle_relief_after_drop",
      "description": "Move the relief call and event before provider destruction; the actual event observer must see the old repository still alive.",
      "edits": [
        {
          "file": "src/mcp/daemon/idle.rs",
          "old": "            drop(provider);",
          "new": "            state.relieve(disposal_event.clone());\n            drop(provider);"
        },
        {
          "file": "src/mcp/daemon/idle.rs",
          "old": "            state.relieve(end);",
          "new": "            // mutant: relief already ran before drop"
        }
      ]
    },
    {
      "id": "I0b-omit-lifecycle-event",
      "selector": "mcp::daemon::idle_wire_logging_tests::daemon_idle_build_failure_event",
      "description": "Omit the terminal build event; scripted build failure must leave a log line.",
      "edits": [
        {
          "file": "src/mcp/daemon/coordinator.rs",
          "old": "                event = Some(self.log_build(&control, &ended));",
          "new": "                // mutant: terminal build event omitted"
        }
      ]
    },
    {
      "id": "I0b-log-under-lock",
      "selector": "mcp::daemon::idle_sink_tests::daemon_idle_sink_initial_build",
      "description": "Emit the captured build event inside settle under slot/control guards; independent control and read dispatch must proceed through a held sink.",
      "edits": [
        {
          "file": "src/mcp/daemon/coordinator.rs",
          "old": "                event = Some(self.log_build(&control, &ended));",
          "new": "                self.lifecycle_event(self.log_build(&control, &ended));"
        }
      ]
    },
    {
      "id": "I0b-diverged-same-snapshot",
      "selector": "mcp::daemon::idle_event_tests::daemon_idle_diverged_same_snapshot_reason",
      "description": "Ignore prior divergence when G is unchanged; the clearing reload must be changed_snapshot.",
      "edits": [
        {
          "file": "src/mcp/daemon/log.rs",
          "old": "                if p.diverged || p.generation != control.generation {",
          "new": "                if p.generation != control.generation {"
        }
      ]
    },
    {
      "id": "I0b-timestamp-at-emission",
      "selector": "mcp::daemon::idle_event_tests::daemon_idle_producer_timestamps",
      "description": "Replace captured wall with emission wall without age correlation; delayed release must retain producer wall.",
      "edits": [
        {
          "file": "src/mcp/daemon/log.rs",
          "old": "        let timestamp = e\n            .wall\n            .duration_since(UNIX_EPOCH)\n            .ok()",
          "new": "        let timestamp = self.wall_now()\n            .duration_since(UNIX_EPOCH)\n            .ok()"
        }
      ]
    },
    {
      "id": "I0b-release-per-call",
      "selector": "mcp::daemon::idle_event_tests::daemon_idle_release_volume",
      "description": "Emit the bounded release event on every tool release, even with idle off.",
      "edits": [
        {
          "file": "src/mcp/daemon/activity.rs",
          "old": "        self.state.wake_idle_loop();",
          "new": "        if let Ok(mut control) = self.state.control_plane() {\n            let event = self.state.take_last_release(&mut control);\n            drop(control);\n            if let Some(event) = event { self.state.lifecycle_event(event); }\n        }\n        self.state.wake_idle_loop();"
        }
      ]
    },
    {
      "id": "I0b-wall-at-emission",
      "selector": "mcp::daemon::idle_event_tests::daemon_idle_producer_wall_jump_forward",
      "description": "Restore emission-wall minus daemon-age correlation; a post-release wall jump must not move the historical release.",
      "edits": [
        {
          "file": "src/mcp/daemon/log.rs",
          "old": "        let timestamp = e\n            .wall\n            .duration_since(UNIX_EPOCH)\n            .ok()",
          "new": "        let timestamp = self.wall_now()\n            .checked_sub(self.now().saturating_duration_since(e.at))\n            .and_then(|at| at.duration_since(UNIX_EPOCH).ok())"
        }
      ]
    },
    {
      "id": "I0b-rejected-provider-held",
      "selector": "mcp::daemon::idle_sink_tests::daemon_idle_sink_rejected_publication",
      "description": "Keep rejected provider in publish across terminal settlement output; Weak must die while the terminal sink is held.",
      "edits": [
        {
          "file": "src/mcp/daemon/coordinator.rs",
          "old": "                Some(provider),\n            );\n            return;",
          "new": "                None,\n            );\n            drop(provider);\n            return;"
        }
      ]
    }
  ]
}
