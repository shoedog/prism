  "R4-04-non-utf8-declines": {
   "disposition": "redefined",
   "intent": "Disable UTF-16 LE/BE BOM decoding; encoded ambient declarations must still suppress paths recovery.",
   "reason": "r5 decodes successfully read non-UTF-8 lossily, so the old non-UTF-8-declines obligation no longer exists. Preserve the historical ID and the 93-mutant population with a distinct decoding obligation, rather than duplicating R4-11's unreadable-file obligation.",
   "killing_fixture": "native_decoding_keeps_ambient_in_both_grammars exercises latin1, UTF-16 LE/BE, UTF-8 and UTF-8 BOM for JSX and TSX, plus a documentation-only negative case."
  },
  "I12-legacy-alias-hop-table": {
   "disposition": "rebound",
   "intent": "Lane-P P2 repartitions the alias export table by caller config path instead of an allowJs bool; the mutant now defeats that per-project lookup by always falling back to the relative-only export table.",
   "reason": "P2 (W1b fold) changed js_ts_path_exports from BTreeMap<bool, ...> to BTreeMap<String, ...> keyed by config path; the old allowJs-bool anchor no longer exists.",
   "killing_fixture": "js_paths_repair_test::js_paths_repair_barrel_hops exercises a non-relative @lib alias hop alongside a relative hop to the same barrel."
  },
  "I15-no-js-hop-cut": {
   "disposition": "rebound",
   "intent": "P1 unconditionally refused JS-family relative hops; P2 admits them under an allowJs + local Node10 priority-pass proof. The mutant now removes that admission guard instead of the old blanket refusal.",
   "reason": "P2 replaced the single-line `(!js_family(&q)).then_some(q)` cut with a conditional admission guard in `Resolver::relative`; the old anchor text no longer exists.",
   "killing_fixture": "js_paths_p2_test::relative_js_guards_preserve_base's 'allow-off' case: without the guard, a JS hop would wrongly bind although allowJs is off."
  },
  "I28-no-reachable-export-priming": {
   "disposition": "rebound",
   "intent": "The loader BFS that primes reachable re-exports now also tracks the owning caller project per pending file; the mutant drops the queued (project, target) pair instead of the old bare target.",
   "reason": "P2 changed `pending` from a `BTreeSet<String>` to `BTreeSet<(String, String)>` so the per-caller-project export table partitions correctly; the old anchor's `pending.insert(target)` shape no longer exists.",
   "killing_fixture": "repo_loader::paths_projection_tests::primes_alias_export_closure_without_unrelated_exports checks that the transitive barrel chain is fully probed and projected."
  },
  "R4-23-project-wrong-allowjs-roots": {
   "disposition": "rebound",
   "intent": "The per-project root-file filter now compares config paths instead of allowJs bools; the mutant still flips the filter's equality to prove the roots partition is load-bearing.",
   "reason": "P2 renamed `js_ts_path_modules`'s value type and this filter's binding from `allow`/`allow_js` (bool) to `owner`/`project` (String); the old anchor text no longer exists.",
   "killing_fixture": "repo_loader::paths_projection_tests::primes_alias_export_closure_without_unrelated_exports: flipping the filter empties the single project's root set. Its project key remains, with an empty export-table value; the expected lib/barrel.ts root is absent."
  },
  "I27-global-export-priming": {
   "disposition": "rebound",
   "intent": "Over-seed the reachable-export priming frontier with every file in the repo (tagged with its own project) instead of only files reachable through real import bindings, to prove priming stays scoped to the actual closure.",
   "reason": "P2 changed `pending` from BTreeSet<String> to BTreeSet<(String, String)> (file plus owning caller project), so the old bare-String over-seed no longer type-checks.",
   "killing_fixture": "repo_loader::paths_projection_tests::primes_alias_export_closure_without_unrelated_exports: over-seeding with every file would wrongly probe unrelated/missing.ts through unrelated/barrel.ts's own star re-export."
  },
