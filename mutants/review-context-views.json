      "if finding.algorithm == \"taint\" {",
      "if true {",
      "targets::context_view_tests::v05_non_taint_keeps_original_maps"
    ],
    "MV06-taint-context-ignored": [
      "crates/prism-review/src/targets/mod.rs",
      "if finding.algorithm == \"taint\" {",
      "if false {",
      "api::map_view::tests::v02_clean_context_witness_survives_an_exact_floor"
    ],
