      "&& true",
      "algorithms::taint::boundary::recovery::tests::synthetic_anchors_require_real_complete_static_syntax"
    ],
    "BR03-useful-owner-chosen": [
      "crates/prism-review/src/algorithms/taint/boundary/recovery/source.rs",
      "let result = candidates.next()?;\n    (candidates.next().is_none() && result.unique && result.function.is_some()).then_some(result)",
      "candidates.next()",
