+/// 6d measurement: operator family of an operand-certificate node.
+fn op_family(parsed: &ParsedFile, node: Node<'_>) -> &'static str {
+    let op = op_text(parsed, node);
+    match node.kind() {
+        "binary_expression" => match op.as_str() {
+            "<" | ">" | "<=" | ">=" | "==" | "!=" | "<=>" => "cmp",
+            "+" | "-" | "*" | "/" | "%" | "&" | "|" | "^" => "arith",
+            "<<" | ">>" => "shift",
+            _ => "other",
+        },
+        _ => "other",
+    }
+}
