+++ b/src/resolution/rust/bin_dep_guard.rs
@@ -0,0 +1,86 @@
+//! #749: the refusals for what a package's binary roots newly reach.
+//!
+//! A binary root keyed with its package's in-repo `[dependencies]` resolves `a::p::q::f()`
+//! through the dependency's module tree. Two hazards of the qualified-path lookup, each
+//! inherited and each newly reachable through these entries, are refused for a result that
+//! lands in a crate the caller's root reaches through a binary-root entry:
+//! - a block or callable scope between the site and its module binds the path's first
+//!   segment in the type namespace: qualified paths start at the enclosing module, chase a
+//!   module-level import and hand the import's scope to the extern fallback, so the block
+//!   binding is never seen (#768; rustc binds the block's);
+//! - the target lies in a file under a `#[path]` mount the populator misplaced (#765: a
+//!   decoy of the file rustc loads). Only the terminal function's file of a direct
+//!   dependency on the authoritative call route is checked; #765's fix removes this part.
+//!
+//! Library roots and own-library edges are untouched.
+use crate::call_graph::CallSite;
+use crate::name_resolution::graph::ScopeGraph;
+use crate::name_resolution::rust_policy::{crate_root_of, NS_TYPE};
+use crate::name_resolution::types::{FileId, ScopeId};
+use crate::resolution::{DropReason, ResolutionOutcome};
+
+/// `out`, or a dropped `UnknownName` when a resolved target lies in a crate reached through
+/// a binary-root dependency entry of `from`'s crate root and either hazard above applies.
+pub(crate) fn guard<'a>(
+    graph: &ScopeGraph,
+    site: &CallSite,
+    from: ScopeId,
+    out: ResolutionOutcome<'a>,
+) -> ResolutionOutcome<'a> {
+    if graph.bin_dep_entries.is_empty() || out.resolved.is_empty() {
+        return out;
+    }
+    let Some(root) = crate_root_of(graph, from) else {
+        return out;
+    };
+    let deps: Vec<ScopeId> = graph
+        .bin_dep_entries
+        .range((root, ScopeId(0))..=(root, ScopeId(u32::MAX)))
+        .map(|&(_, target)| target)
+        .collect();
+    if deps.is_empty() {
+        return out;
+    }
+    let in_dep = |file: &str| {
+        graph
+            .file_paths
+            .get(file)
+            .and_then(|&id| file_crate_root(graph, id))
+            .is_some_and(|target_root| deps.contains(&target_root))
+    };
+    let shadowed = site
+        .callee_name
+        .split_once("::")
+        .is_some_and(|(first, _)| block_binds_type(graph, from, first));
+    let refused = out.resolved.iter().any(|r| {
+        let misplaced = graph
+            .file_paths
+            .get(&r.target.file)
+            .is_some_and(|id| graph.misplaced_mount_files.contains(id));
+        (shadowed || misplaced) && in_dep(&r.target.file)
+    });
+    if refused {
+        ResolutionOutcome::dropped(DropReason::UnknownName)
+    } else {
+        out
+    }
+}
+
+/// A block or callable scope between `from` and its enclosing module binds `name` in the type
+/// namespace (the lexical-prefix check of #724's self-alias refusal).
+fn block_binds_type(graph: &ScopeGraph, from: ScopeId, name: &str) -> bool {
+    let (local, _) = super::path_anchor::local_scopes_and_module(graph, from);
+    local
