{
  "openapi": "3.1.0",
  "info": {
    "title": "Moonspindle Exchange",
    "version": "1.0.0"
  },
  "paths": {
    "/reed": {
      "get": {
        "responses": {
          "200": {
            "description": "Successful exchange",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "gate": false,
                        "ghostWax": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "gate"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "wax": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "wax"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
