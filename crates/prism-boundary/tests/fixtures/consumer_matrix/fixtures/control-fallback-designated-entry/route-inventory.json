{
  "api": "sable-quay",
  "origin": "https://sable-quay.invalid",
  "api_mount": "/api",
  "routes": [
    {
      "method": "GET",
      "path": "/api/a",
      "site": "routes.js:2"
    },
    {
      "method": "GET",
      "path": "/{*0+}",
      "role": "fallback",
      "site": "routes.js:3",
      "role_selector": {
        "file": "routes.js",
        "collection": "routes",
        "entry": 2
      }
    }
  ]
}
